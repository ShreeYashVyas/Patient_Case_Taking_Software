# Copy this file to .env and set your own values.
PORT=5000
MONGO_URI=
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Temporary account setup values. Set these only when running scripts/createUser.js,
# then remove them from .env after the account is created.
BOOTSTRAP_USER_NAME=
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_PASSWORD=
BOOTSTRAP_USER_ROLE=
# Required only when BOOTSTRAP_USER_ROLE=patient; use an existing MongoDB patient _id.
BOOTSTRAP_PATIENT_ID=
